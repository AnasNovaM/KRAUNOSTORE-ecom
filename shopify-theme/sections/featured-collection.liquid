{%- assign featured = section.settings.collection -%}
{%- assign products_to_show = section.settings.products_count | default: 6 -%}

<section class="featured-collection" aria-label="Featured products">
  <div class="featured-collection-inner">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <div class="section-header-row">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="lede" style="margin-top:8px;">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if featured != blank -%}
          <a href="{{ featured.url }}" class="btn-text">View all &rarr;</a>
        {%- endif -%}
      </div>
    </div>

    <div class="product-grid">
      {%- if featured != blank -%}
        {%- for product in featured.products limit: products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          {%- render 'product-card-placeholder', index: i -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Editor's selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What we carry."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A considered set of tools. Nothing redundant."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Number of products",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

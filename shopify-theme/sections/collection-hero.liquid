{%- assign pillar_class = '' -%}
{%- if collection.handle == 'work' -%}
  {%- assign pillar_class = 'collection-hero--work' -%}
{%- elsif collection.handle == 'recover' -%}
  {%- assign pillar_class = 'collection-hero--recover' -%}
{%- elsif collection.handle == 'rest' -%}
  {%- assign pillar_class = 'collection-hero--rest' -%}
{%- endif -%}

<section class="collection-hero {{ pillar_class }}" aria-label="Collection introduction">
  <div class="collection-hero-inner">
    <div style="max-width:720px; padding: 64px 0;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" style="margin-bottom:16px;">{{ section.settings.eyebrow }}</p>
      {%- elsif collection != blank -%}
        <p class="eyebrow" style="margin-bottom:16px;">{{ collection.title }}</p>
      {%- endif -%}

      <h1 style="margin-bottom:16px;">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- elsif collection != blank -%}
          {{ collection.title }}
        {%- else -%}
          All products
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="lede">{{ section.settings.subheading }}</p>
      {%- elsif collection.description != blank -%}
        <p class="lede">{{ collection.description }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (leave blank to use collection title)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use collection title)"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (leave blank to use collection description)"
    }
  ],
  "presets": [
    {
      "name": "Collection Hero"
    }
  ]
}
{% endschema %}

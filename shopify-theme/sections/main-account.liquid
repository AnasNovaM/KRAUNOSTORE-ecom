<div class="customer-page" style="max-width:800px;">
  <h1>Your account</h1>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
    <p>Hello, {{ customer.first_name }}.</p>
    <a href="/account/logout" class="btn-text">Sign out</a>
  </div>

  <!-- Order History -->
  <section style="margin-bottom:48px;">
    <h2 style="font-size:1.25rem;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--hairline);">Order history</h2>

    {%- if customer.orders.size == 0 -%}
      <p style="color:var(--ink-3);">No orders yet. <a href="/collections/all" style="color:var(--clay);">Start browsing.</a></p>
    {%- else -%}
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr>
            <th style="text-align:left;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding-bottom:12px;">Order</th>
            <th style="text-align:left;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding-bottom:12px;">Date</th>
            <th style="text-align:left;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding-bottom:12px;">Status</th>
            <th style="text-align:right;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding-bottom:12px;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-top:1px solid var(--hairline);">
              <td style="padding:16px 0;">
                <a href="{{ order.customer_url }}" style="color:var(--clay);font-family:var(--font-mono);font-size:0.875rem;">
                  {{ order.name }}
                </a>
              </td>
              <td style="padding:16px 0;font-size:0.875rem;color:var(--ink-2);">{{ order.created_at | date: "%B %d, %Y" }}</td>
              <td style="padding:16px 0;font-size:0.875rem;color:var(--ink-2);">{{ order.financial_status_label }}</td>
              <td style="padding:16px 0;font-family:var(--font-mono);font-size:0.875rem;text-align:right;">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
  </section>

  <!-- Account Details -->
  <section>
    <h2 style="font-size:1.25rem;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--hairline);">Account details</h2>
    <p style="font-size:0.9375rem;color:var(--ink-2);margin-bottom:4px;">{{ customer.name }}</p>
    <p style="font-size:0.9375rem;color:var(--ink-2);">{{ customer.email }}</p>
    {%- if customer.default_address -%}
      <address style="font-size:0.875rem;color:var(--ink-3);margin-top:16px;font-style:normal;line-height:1.6;">
        {{ customer.default_address | format_address }}
      </address>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}

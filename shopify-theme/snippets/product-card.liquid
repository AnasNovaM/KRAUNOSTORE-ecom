{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<a href="{{ product.url }}" class="product-card" aria-label="{{ product.title | escape }}">
  <!-- Image -->
  <div class="product-card-image">
    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                {{ product.featured_image | image_url: width: 600 }} 600w,
                {{ product.featured_image | image_url: width: 900 }} 900w"
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600"
        height="750"
      >
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--pillar-work);"></div>
    {%- endif -%}

    {%- if on_sale -%}
      <span class="sale-badge">Sale</span>
    {%- endif -%}
  </div>

  <!-- Body -->
  <div class="product-card-body">
    <h3 class="product-card-title">{{ product.title }}</h3>

    {%- if product.metafields.custom.blurb != blank -%}
      <p class="product-card-blurb">{{ product.metafields.custom.blurb }}</p>
    {%- elsif product.description != blank -%}
      <p class="product-card-blurb">{{ product.description | strip_html | truncatewords: 12 }}</p>
    {%- endif -%}

    <div class="product-card-price">
      {%- if on_sale -%}
        <span class="price price--sale">{{ product.price | money }}</span>
        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span class="price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</a>
